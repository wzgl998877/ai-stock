# === 大模型 ===
OPENAI_API_KEY=sk-your-key
OPENAI_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

# === 数据库 ===
DATABASE_URL=mysql+aiomysql://root:password@localhost:3306/ai_stock

# === Redis ===
# 格式: redis://:密码@主机:端口/数据库编号
REDIS_URL=redis://:your_redis_password@localhost:6379/0

# === 服务 ===
HOST=0.0.0.0
PORT=8000

# === 应用 ===
LOG_LEVEL=info
LOG_DIR=logs
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=10
CORS_ORIGINS=["*"]
ANALYSIS_TIMEOUT=120

# === 相似检测 ===
SIMILARITY_THRESHOLD=0.3

# === 搜索 ===
# Tavily（兼容旧配置，单 Key）
TAVILY_API_KEY=
# 多引擎搜索 Key（逗号分隔多个 Key 实现负载均衡，按优先级：Anspire > Bocha > Tavily）
ANSPIRE_API_KEYS=
BOCHA_API_KEYS=
TAVILY_API_KEYS=
# 新闻时效策略：ultra_short(1天) / short(3天) / medium(7天) / long(30天)
NEWS_STRATEGY_PROFILE=short
# 新闻最大时效天数（兜底值）
NEWS_MAX_AGE_DAYS=3
# 搜索结果缓存 TTL（秒）
SEARCH_CACHE_TTL=600
# 搜索请求超时（秒）
SEARCH_REQUEST_TIMEOUT=10

# === 数据源加密 ===
DATASOURCE_ENCRYPTION_KEY=
