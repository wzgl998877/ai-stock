# === 大模型 ===
OPENAI_API_KEY=sk-your-key
OPENAI_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

# === 数据库 ===
DATABASE_URL=mysql+aiomysql://root:password@localhost:3306/ai_stock

# === Redis ===
# 格式: redis://:密码@主机:端口/数据库编号
REDIS_URL=redis://:your_redis_password@localhost:6379/0

# === 服务 ===
HOST=0.0.0.0
PORT=8000

# === 应用 ===
LOG_LEVEL=info
LOG_DIR=logs
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=10
CORS_ORIGINS=["*"]
ANALYSIS_TIMEOUT=120

# === 相似检测 ===
SIMILARITY_THRESHOLD=0.3

# === 搜索 ===
# Tavily（兼容旧配置，单 Key）
TAVILY_API_KEY=
# 多引擎搜索 Key（逗号分隔多个 Key 实现负载均衡，按优先级：Anspire > Bocha > Tavily）
ANSPIRE_API_KEYS=
BOCHA_API_KEYS=
TAVILY_API_KEYS=
# 新闻时效策略：ultra_short(1天) / short(3天) / medium(7天) / long(30天)
NEWS_STRATEGY_PROFILE=short
# 新闻最大时效天数（兜底值）
NEWS_MAX_AGE_DAYS=3
# 搜索结果缓存 TTL（秒）
SEARCH_CACHE_TTL=600
# 搜索请求超时（秒）
SEARCH_REQUEST_TIMEOUT=10

# === 数据源加密 ===
DATASOURCE_ENCRYPTION_KEY=

# === RAG 语义检索 ===
# RAG 全局开关，关闭后所有检索降级到 FULLTEXT
RAG_ENABLED=true
# Embedding 模型（首次启动自动下载到 ~/.cache/huggingface/，约 1.3GB）
RAG_EMBEDDING_MODEL=BAAI/bge-large-zh-v1.5
# ChromaDB 向量数据持久化目录
RAG_VECTOR_DB_PATH=./data/vector_db
# 语义检索相似度阈值（retrieve 节点 & 事件关联，默认 0.6，中文语义建议 0.5-0.65）
RAG_SIMILARITY_THRESHOLD=0.6
# 事件去重语义相似度阈值（默认 0.85，比检索更严格）
RAG_DEDUP_THRESHOLD=0.85
# Agent 注入知识库上下文最大字数
RAG_MAX_CONTEXT_LENGTH=2000

# === 事件采集 ===
# 事件采集调度器开关，本地开发可设为 false 禁用
EVENT_CRAWL_ENABLED=true

# === 微信 iLink Bot 推送（缠论信号） ===
# 推送总开关；开启前需满足：1) 配置 bot_token 和接收人 user_id；2) 接收人先给 bot 发送过
# 任意一条消息（激活 context_token，协议要求回复必须携带用户最近一条入站消息的 token）。
# 注意：长轮询与推送共用同一 bot_token，若本机还跑着 cc-connect 等同 token 客户端请勿同时开启。
# 多 worker 部署（uvicorn --workers N）时长轮询会多实例互相抢消息，需确保单实例。
WECHAT_PUSH_ENABLED=false
WECHAT_ILINK_BOT_TOKEN=
WECHAT_ILINK_USER_ID=
# WECHAT_ILINK_BASE_URL=https://ilinkai.weixin.qq.com
# WECHAT_ILINK_CLIENT_VERSION=196608
# WECHAT_ILINK_POLL_TIMEOUT=35
# WECHAT_ILINK_BACKOFF_MAX=60
